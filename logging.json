{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": { "format": "%(levelname)s: %(message)s" }
  },
  "filters": {
    "below_warning": { "()": "app.logs.BelowWarning" }
  },
  "handlers": {
    "out": { "class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "plain", "filters": ["below_warning"] },
    "err": { "class": "logging.StreamHandler", "stream": "ext://sys.stderr", "formatter": "plain", "level": "WARNING" }
  },
  "root": { "level": "INFO", "handlers": ["out", "err"] },
  "loggers": {
    "uvicorn.access": { "level": "WARNING" }
  }
}
